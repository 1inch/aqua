# ---------------------------------------------------------------------------
# Makefile / Foundry deploy path (loaded from .env by the Makefile)
# ---------------------------------------------------------------------------
OPS_NETWORK="localhost"
OPS_CHAIN_ID="31337"

# RPC URL for localhost network
LOCALHOST_RPC_URL=http://localhost:8545
# Replace with your own private key for localhost testing
LOCALHOST_PRIVATE_KEY=0x

# Mainnet RPC URL for forking a local development node
NODE_URL=https://eth.drpc.org

# ---------------------------------------------------------------------------
# Hardhat configuration variables
#
# Hardhat 3 does NOT read this file. Provide these either as environment
# variables of the same name, or via the encrypted keystore:
#   npx hardhat keystore set SEPOLIA_RPC_URL
# ---------------------------------------------------------------------------
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
ETHERSCAN_API_KEY=
